<Window x:Class="QS3D.Cad.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D CAD — Standalone" Height="820" Width="1320" MinHeight="640" MinWidth="980">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Click="New_Click" />
        <MenuItem Header="_Open project..." Click="Open_Click" />
        <MenuItem Header="_Save project..." Click="Save_Click" />
      </MenuItem>
      <MenuItem Header="_Draw">
        <MenuItem Header="Line" Click="Line_Click" />
        <MenuItem Header="Circle" Click="Circle_Click" />
      </MenuItem>
    </Menu>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="New" Click="New_Click" />
      <Button Content="Open" Click="Open_Click" />
      <Button Content="Save" Click="Save_Click" />
      <Separator />
      <Button Content="Undo" Click="Undo_Click" />
      <Button Content="Redo" Click="Redo_Click" />
      <Separator />
      <Button Content="Refresh" Click="Refresh_Click" />
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" Text="Ready" />
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Project / Drawing" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox x:Name="DocumentList" />
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Background="#202124">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="Native viewport adapter not connected yet.&#x0a;Reference entities are listed below for deterministic host development."
                     Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" TextAlignment="Center" />
          <ListBox x:Name="EntityList" Margin="24,86,24,24" Background="#303134" Foreground="White" BorderThickness="0" />
        </Grid>
        <DockPanel Grid.Row="1" Margin="8">
          <TextBlock Text="Command:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button DockPanel.Dock="Right" Content="Run" Click="Run_Click" Margin="8,0,0,0" Padding="16,4" />
          <TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown" />
        </DockPanel>
      </Grid>
      <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Properties / Messages" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox x:Name="MessageList" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
